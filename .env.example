# Supabase — copy to .env.local and fill in (never commit .env.local).
# Project URL and anon key from: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only (migrations/seed/admin tasks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) keys for out-of-app browser notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@keyvendors.com
